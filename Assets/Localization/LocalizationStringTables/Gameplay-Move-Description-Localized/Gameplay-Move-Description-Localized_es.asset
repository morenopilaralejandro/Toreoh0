  m_TableData:
  - m_Id: 552899190784
    m_Localized: Prueba
    m_Metadata:
      m_Items: []
  - m_Id: 552903385088
    m_Localized: "Dispara una banderilla de energ\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 552903385089
    m_Localized: Realiza un ataque cuerpo a cuerpo con la muleta.
    m_Metadata:
      m_Items: []
  - m_Id: 552903385090
    m_Localized: "Dispara dos banderillas de energ\xEDa."
    m_Metadata:
      m_Items: []
  - m_Id: 552903385091
    m_Localized: Realiza un ataque mortal con el estoque.
    m_Metadata:
      m_Items: []
  - m_Id: 552903385092
    m_Localized: "Desata un poderoso rayo de energ\xEDa electrica."
    m_Metadata:
      m_Items: []
  - m_Id: 552903385093
    m_Localized: "Desata un vendaval de balas capaz de destruir la V\xEDa L\xE1ctea."
    m_Metadata:
      m_Items: []
  - m_Id: 552903385094
    m_Localized: Desata un peligroso espiral del que es imposible escapar.
    m_Metadata:
      m_Items: []
  - m_Id: 552903385095
    m_Localized: "Realiza un ataque en \xE1rea usando sus afiladas garras."
    m_Metadata:
      m_Items: []
  - m_Id: 552903385096
    m_Localized: Dispara tres balas que limitan el movimento del oponente.
    m_Metadata:
      m_Items: []
  - m_Id: 552903385097
    m_Localized: "Apu\xF1ala al oponenente con sus garras para robar su energ\xEDa
      vital."
    m_Metadata:
      m_Items: []
  - m_Id: 552903385098
    m_Localized: Desata un rayo maligno con un poder desbordante.
    m_Metadata:
      m_Items: []
  - m_Id: 552903385099
    m_Localized: "Desata un espiral de destrucci\xF3n capaz de robar la energ\xEDa
      vital de un planeta."
    m_Metadata:
      m_Items: []
